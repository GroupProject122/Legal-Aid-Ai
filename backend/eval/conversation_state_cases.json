      "domains": ["cyber"],
      "known_facts": ["Someone accessed online account without permission."],
      "message": "ok",
      "expected_turn_type": "acknowledgement",
      "should_bypass_pipeline": true
    },
    {
      "case_id": "conv_15_more_fact_consumer",
      "initial_summary": "Online seller did not deliver product.",
      "domains": ["consumer", "cyber"],
      "known_facts": ["Online seller took payment.", "Product not delivered."],
      "message": "The seller blocked me after I asked for refund.",
      "expected_turn_type": "additional_fact",
      "must_preserve": ["blocked me", "refund"]
    },
    {
      "case_id": "conv_16_unrelated_divorce_from_cyber",
      "initial_summary": "Cyber phishing payment issue.",
      "domains": ["cyber"],
      "known_facts": ["Phishing link caused payment loss."],
      "message": "My wife filed for divorce.",
      "expected_turn_type": "new_issue",
      "must_not_preserve": ["phishing"]
