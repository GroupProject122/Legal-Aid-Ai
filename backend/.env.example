GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_UPLOAD_SIZE_MB=10
EMBEDDING_PROVIDER=local
LLM_PROVIDER=gemini
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# Hinglish -> English rewrite of retrieval queries (query_normalizer.py). Off by default: no
# measurable end-to-end difference on the current test set, and each rewrite is an extra Gemini call.
HINGLISH_RETRIEVAL_NORMALIZER=false
