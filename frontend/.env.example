# Base URL for the Schemes & Legal Support backend (the separate Node service).
#
# Dev: leave this UNSET. Requests then go to the "/schemes-api" path, which
# vite.config.js proxies to http://localhost:4000 (same idea as "/api" ->
# the Python backend on :8000).
#
# Prod: set it to the deployed origin, e.g.
#   VITE_SCHEMES_API_BASE_URL=https://schemes-api.example.org
VITE_SCHEMES_API_BASE_URL=
